#!/bin/bash
set -euxo pipefail

echo "=== Waiting for Instruqt bootstrap ==="
while [ ! -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    sleep 1
done

echo "=== Installing system packages ==="
apt-get update -qq
apt-get install -y -qq python3 python3-pip python3-venv curl zstd git 2>&1 | tail -3

echo "=== Installing Ollama ==="
curl -fsSL https://ollama.com/install.sh | sh 2>&1 | tail -5

echo "=== Starting Ollama server ==="
nohup ollama serve > /var/log/ollama.log 2>&1 &
for i in $(seq 1 30); do
    if curl -s http://localhost:11434/api/tags > /dev/null 2>&1; then break; fi
    sleep 2
done

echo "=== Pulling chat model (qwen2.5:3b) ==="
ollama pull qwen2.5:3b 2>&1 | tail -3

echo "=== Pulling embedding model (nomic-embed-text) ==="
ollama pull nomic-embed-text 2>&1 | tail -3

echo "=== Installing code-server ==="
curl -fsSL https://code-server.dev/install.sh | sh 2>&1 | tail -3

echo "=== Cloning lab repository ==="
cd /root
git clone https://github.com/SANTANNA001/mongo-9-agent-demo.git
cd /root/mongo-9-agent-demo

echo "=== Setting up Python virtual environment ==="
python3 -m venv .venv
.venv/bin/pip install --upgrade pip 2>&1 | tail -1
.venv/bin/pip install notebook 2>&1 | tail -3
.venv/bin/pip install -r requirements.txt 2>&1 | tail -3

echo "=== Registering venv as Jupyter kernel ==="
.venv/bin/pip install ipykernel 2>&1 | tail -1
.venv/bin/python -m ipykernel install --user --name mongo-9-agent-demo --display-name "Python 3 (mongo-9-agent-demo)" 2>&1

echo "=== Verifying venv Python ==="
.venv/bin/python -c "import sklearn, ollama, requests; print('venv OK')"

echo "=== Configuring code-server ==="
mkdir -p /root/.config/code-server /root/.local/share/code-server/User

# Server config — dark mode, no auth, no telemetry
cat > /root/.config/code-server/config.yaml << 'EOF'
bind-addr: 0.0.0.0:8080
auth: none
cert: false
disable-telemetry: true
disable-update-check: true
EOF

# User settings — dark theme, auto-select venv kernel
cat > /root/.local/share/code-server/User/settings.json << 'EOF'
{
    "workbench.colorTheme": "Default Dark Modern",
    "workbench.startupEditor": "none",
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "security.workspace.trust.enabled": false,
    "jupyter.kernels.filter": [
        {"path": "/root/mongo-9-agent-demo/.venv/bin/python"},
        {"displayName": "Python 3 (mongo-9-agent-demo)"}
    ]
}
EOF

echo "=== Installing VS Code extensions ==="
code-server --install-extension ms-python.python 2>&1 | tail -1
code-server --install-extension ms-toolsai.jupyter 2>&1 | tail -1

echo "=== Configuring workspace Python path ==="
mkdir -p /root/mongo-9-agent-demo/.vscode
cat > /root/mongo-9-agent-demo/.vscode/settings.json << 'EOF'
{
    "python.defaultInterpreterPath": "/root/mongo-9-agent-demo/.venv/bin/python",
    "jupyter.jupyterServerType": "local",
    "notebook.defaultKernel": "/root/mongo-9-agent-demo/.venv/bin/python"
}
EOF

echo "=== Starting code-server ==="
nohup code-server /root/mongo-9-agent-demo > /var/log/code-server.log 2>&1 &

for i in $(seq 1 20); do
    if curl -s http://localhost:8080 > /dev/null 2>&1; then break; fi
    sleep 2
done

echo "=== Setup complete ==="
